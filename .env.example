# PostgreSQL database user name
POSTGRES_USER=postgres

# PostgreSQL database user password
POSTGRES_PASSWORD=postgres

# PostgreSQL default database name
POSTGRES_DB=civara_db

# PostgreSQL host address for backend connection
POSTGRES_HOST=localhost

# PostgreSQL port exposed by database container
POSTGRES_PORT=5432

# Database connection URL used by SQLAlchemy and Alembic (uses psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civara_db

# Redis server host address
REDIS_HOST=localhost

# Redis server port number
REDIS_PORT=6379

# Redis connection URL used by backend cache and queue modules
REDIS_URL=redis://localhost:6379/0

# Backend FastAPI service port
BACKEND_PORT=8005

# Backend execution environment (development, staging, production)
ENVIRONMENT=development

# Optional AI service API key placeholder (for future phases)
AI_API_KEY=your_ai_api_key_here

# Frontend public API URL used to query backend endpoints
NEXT_PUBLIC_API_URL=http://localhost:8005
